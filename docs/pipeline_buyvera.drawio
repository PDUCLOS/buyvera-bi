<mxfile host="app.diagrams.net" agent="buyvera-bi"><diagram name="1 - Pipeline de données" id="pipe"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="pipe-3" value="&lt;b&gt;Buyvera BI : pipeline de données&lt;/b&gt; (sources réelles + synthétiques → contrôles → Power BI / tableau de bord Claude → publication)" style="text;align=left;whiteSpace=wrap;html=1;fillColor=#EEF0F3;strokeColor=#4A5568;fontSize=11;fontColor=#1A202C;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="30" as="geometry"/></mxCell><mxCell id="pipe-4" value="① Sources" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#A0AEC0;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontSize=13;fontColor=#4A5568;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="260" height="640" as="geometry"/></mxCell><mxCell id="pipe-5" value="&lt;b&gt;INSEE BDM&lt;/b&gt;&lt;br&gt;Cuivre 010767327 / 010002094&lt;br&gt;Alu 010002093 · Nickel 010002096&lt;br&gt;Zinc 010002098 · Ferreux 010002103&lt;br&gt;Naphta 010002090&lt;br&gt;&lt;i&gt;CSV ou API SDMX&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A202C;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="110" as="geometry"/></mxCell><mxCell id="pipe-6" value="&lt;b&gt;Banque mondiale&lt;/b&gt;&lt;br&gt;Pink Sheet CMO-Historical-Data-Monthly.xlsx&lt;br&gt;&lt;i&gt;contrôle / complément&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1FB;strokeColor=#2B6CB0;fontSize=11;fontColor=#1A202C;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="220" height="70" as="geometry"/></mxCell><mxCell id="pipe-7" value="&lt;b&gt;IPPI (option)&lt;/b&gt;&lt;br&gt;sinon hypothèse 2 %/an affichée" style