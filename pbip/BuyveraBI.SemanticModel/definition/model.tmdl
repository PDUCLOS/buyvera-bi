model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: fr-FR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DossierDonnees", "dim_date", "dim_fournisseur", "dim_famille", "dim_acheteur", "dim_matiere", "dim_article", "bridge_composition", "fact_tarif", "fact_achats", "fact_indice", "fact_hausse_article", "fact_impact_matiere", "fact_indice_fournisseur", "ml_prevision_indices", "ml_variation_2027", "ml_plafond_2027", "ml_segments_fournisseurs", "ml_anomalies_tarif", "dim_entite", "fact_achats_entite", "fact_negociation"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBIDesktopVersion = 2.149.1429.0 (25.11)

ref table dim_date
ref table dim_fournisseur
ref table dim_famille
ref table dim_acheteur
ref table dim_matiere
ref table dim_article
ref table bridge_composition
