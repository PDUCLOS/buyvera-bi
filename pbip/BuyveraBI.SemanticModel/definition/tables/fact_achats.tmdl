/// Quantités achetées par article et par mois (synthétique, Pareto 80/20).
table fact_achats
	lineageTag: 870d7a08-3781-5271-a046-8690e3881beb

	/// Article.
	column article_id
		dataType: string
		isHidden
		lineageTag: 64ead3ef-f061-5f90-8875-c85107f2c6c5
		summarizeBy: none
		sourceColumn: article_id

		annotation SummarizationSetBy = User

	/// Mois d'achat (1er du mois).
	column date
		dataType: dateTime
		formatString: Short Date
		isHidden
		lineageTag: d6dcc911-dc04-5768-a635-50166f4729e9
		summarizeBy: none
		sourceColumn: date

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = User

	/// Quantité achetée sur le mois.
	column quantite
		dataType: int64
		formatString: #,0
		lineageTag: ddcc40f7-8e7c-5993-9e62-7f5bdafcb33c
		summarizeBy: sum
		sourceColumn: quantite

		annotation SummarizationSetBy = User

	/// Prix brut du tarif en vigueur l'année de l'achat.
	column prix_unitaire = LOOKUPVALUE ( fact_tarif[prix_brut], fact_tarif[article_id], fact_achats[article_id], fact_tarif[campagne], YEAR ( fact_achats[date] ) )
		dataType: double
		formatString: #,0.00
		isHidden
		lineageTag: 5c6e08b7-8011-5420-a81c-a62ffa594e5c
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// Quantité × prix brut de l'année.
	column montant = fact_achats[quantite] * fact_achats[prix_unitaire]
		dataType: double
		formatString: #,0
		isHidden
		lineageTag: a648722f-6807-5cf7-93b4-74c9917c39df
		summarizeBy: sum

		annotation SummarizationSetBy = User

	partition fact_achats = m
		mode: import
		source =
				let
				    Source = Csv.Document ( File.Contents ( DossierDonnees & "fact_achats.csv" ), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv] ),
				    Entetes = Table.PromoteHeaders ( Source, [PromoteAllScalars = true] ),
				    Types = Table.TransformColumnTypes ( Entetes, {{"article_id", type text}, {"date", type date}, {"quantite", Int64.Type}}, "en-US" )
				in
				    Types

	annotation PBI_ResultType = Table
