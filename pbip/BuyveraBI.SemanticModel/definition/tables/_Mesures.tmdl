	/// Hausse acceptée par l'acheteur (segment du simulateur, 2 % par défaut).
	measure 'Hausse acceptée %' = DIVIDE ( SELECTEDVALUE ( param_hausse[hausse_acceptee], 2 ), 100 )
		formatString: 0.0%
		displayFolder: 6. Négociation
		lineageTag: 2d7cf76b-3df3-5a62-94f9-67964f0e5105

	/// Σ par article de MAX(0, hausse demandée − hausse acceptée) × prix N × volume N : gain si le fournisseur accepte la contre-proposition.
	measure '€ économisés (contre-proposition)' = ```
			VAR _acc = [Hausse acceptée %]
			VAR _c = [Campagne N+1]
			VAR _w = [Fenêtre mois]
			VAR _lag = [Décalage mois]
			VAR _t =
			    CALCULATETABLE (
			        fact_hausse_article,
			        fact_hausse_article[campagne] = _c,
			        fact_hausse_article[fenetre] = _w,
			        fact_hausse_article[decalage] = _lag,
			        fact_hausse_article[comparable] = TRUE ()
			    )
			RETURN
			    SUMX ( _t, MAX ( 0, DIVIDE ( fact_hausse_article[prix_n1], fact_hausse_article[prix_n] ) - 1 - _acc ) * fact_hausse_article[prix_n] * fact_hausse_article[volume_n] )
			```
		formatString: #,0 €
		displayFolder: 6. Négociation
		lineageTag: c466a434-f02f-5724-b067-3464809f2a55

	/// Couleur de statut de l'écart (ambre foncé > 3 pts, ambre > 1 pt, vert sinon) pour la mise en forme conditionnelle.
	measure 'Couleur écart' = ```
			VAR _e = [Écart pts]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _e ), "#56655F", _e > 3, "#C9781C", _e > 1, "#D9A441", "#0F5C4A" )
			```
		displayFolder: 6. Négociation
		lineageTag: 1472148e-db71-5f5d-b684-586dd02c3742

	/// Statut lisible (icône + libellé) : À renégocier, À surveiller ou Conforme.
	measure 'Statut fournisseur' = ```
			VAR _e = [Écart pts]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _e ), BLANK (), _e > 3, "▲ À renégocier", _e > 1, "◆ À surveiller", "● Conforme" )
			```
		displayFolder: 6. Négociation
		lineageTag: 75ca9666-b7f5-5fa4-881f-fe6292191735

	/// Matière du panier du fournisseur qui a le plus baissé sur la fenêtre : argument de négociation.
	measure 'Levier matière' = ```
			VAR _t =
			    FILTER (
			        ADDCOLUMNS ( VALUES ( dim_matiere[libelle] ), "@v", [Variation matière article %] ),
			        NOT ISBLANK ( [@v] )
			    )
			VAR _min = TOPN ( 1, _t, [@v], ASC )
			RETURN
			    IF ( COUNTROWS ( _t ) > 0,
			        MAXX ( _min, dim_matiere[libelle] & " " & FORMAT ( [@v], "+0.0 %;-0.0 %" ) & " (fenêtre de la campagne)" ) )
			```
		displayFolder: 6. Négociation
		lineageTag: 54cab73d-33eb-5d4b-ad60-31aa24743800

	/// Phrase de synthèse générée pour le fournisseur sélectionné (support de négociation).
	measure 'Commentaire négociation' = ```
			VAR _f = SELECTEDVALUE ( dim_fournisseur[nom] )
			VAR _d = [Hausse demandée %]
			VAR _j = [Hausse justifiée %]
			VAR _e = [Écart pts]
			VAR _eur = [€ renégociables]
			VAR _lev = [Levier matière]
			VAR _cli = [Effet cliquet]
			RETURN
			    IF ( ISBLANK ( _f ), "Choisissez un fournisseur pour générer sa fiche.",
			        "Demande " & FORMAT ( _d, "+0.0 %;-0.0 %" ) & " pour " & FORMAT ( _j, "+0.0 %;-0.0 %" ) & " justifiés"
			            & IF ( _e > 1, " · à renégocier " & FORMAT ( _eur, "# ##0 €" ),
			                " · conforme globalement" & IF ( _eur > 0, " (écarts ligne à ligne : " & FORMAT ( _eur, "# ##0 €" ) & ")", "" ) )
			            & IF ( NOT ISBLANK ( _lev ), " · levier " & _lev, "" )
			            & IF ( _cli > 0, " · cliquet " & _cli & " camp.", "" ) )
			```
		displayFolder: 6. Négociation
		lineageTag: e240ea0b-a1c3-5dab-8c4a-a0cb582f02c8

	/// Valeur de l'indice au dernier mois disponible.
	measure 'Dernier indice' = ```
			VAR _last = CALCULATE ( MAX ( fact_indice[date] ), ALL ( fact_indice ) )
			VAR _compo = SELECTEDVALUE ( dim_matiere[utilisee_composition] ) = TRUE ()
			VAR _v = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ), dim_date[date] = _last )
			RETURN
			    IF ( HASONEVALUE ( dim_matiere[matiere_id] ) && _compo, _v )
			```
		formatString: #,0.0
		displayFolder: 7. Alertes
		lineageTag: 326cb4b0-a8af-58f5-b9ef-60813dfc49c3

	/// Dernier indice / indice 3 mois plus tôt − 1 (signal court terme).
	measure 'Variation 3 mois %' = ```
			VAR _last = CALCULATE ( MAX ( fact_indice[date] ), ALL ( fact_indice ) )
			VAR _compo = SELECTEDVALUE ( dim_matiere[utilisee_composition] ) = TRUE ()
			VAR _v1 = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ), dim_date[date] = _last )
			VAR _v0 = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ), dim_date[date] = EDATE ( _last, -3 ) )
			VAR _r = DIVIDE ( _v1, _v0 )
			RETURN
			    IF ( HASONEVALUE ( dim_matiere[matiere_id] ) && _compo && NOT ISBLANK ( _r ), _r - 1 )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Alertes
		lineageTag: c2772821-bcc4-515a-a8d2-10879f94726a

	/// Dernier indice / indice 12 mois plus tôt − 1 (tendance).
	measure 'Variation 12 mois %' = ```
			VAR _last = CALCULATE ( MAX ( fact_indice[date] ), ALL ( fact_indice ) )
			VAR _compo = SELECTEDVALUE ( dim_matiere[utilisee_composition] ) = TRUE ()
			VAR _v1 = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ), dim_date[date] = _last )
			VAR _v0 = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ), dim_date[date] = EDATE ( _last, -12 ) )
			VAR _r = DIVIDE ( _v1, _v0 )
			RETURN
			    IF ( HASONEVALUE ( dim_matiere[matiere_id] ) && _compo && NOT ISBLANK ( _r ), _r - 1 )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Alertes
		lineageTag: 97bb800a-ac19-5733-ba34-dd5e5b030947

	/// Signal 3 mois confirmé par la tendance 12 mois. ▲ hausse > 5 % sur 3 mois et 12 mois ≥ 0 ; ▼ baisse > 5 % sur 3 mois et 12 mois ≤ 0 (convoquer) ; ◆ signal mixte quand les deux fenêtres se contredisent ; ● stable.
	measure 'Alerte matière' = ```
			VAR _v3 = [Variation 3 mois %]
			VAR _v12 = [Variation 12 mois %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v3 ), BLANK (),
			        _v3 > 0.05 && _v12 >= 0, "▲ Hausse 3 et 12 mois : anticiper",
			        _v3 < -0.05 && _v12 <= 0, "▼ Baisse 3 et 12 mois : convoquer",
			        ABS ( _v3 ) > 0.05, "◆ Signal mixte : 3 mois " & IF ( _v3 > 0, "▲", "▼" ) & ", 12 mois " & IF ( _v12 > 0, "▲", "▼" ),
			        "● Stable sur 3 mois" )
			```
		displayFolder: 7. Alertes
		lineageTag: f66f27ac-300f-5ae5-87e4-443967d9b651

	/// Couleur du signal matière (ambre = hausse, vert = baisse confirmée, ambre clair = mixte, gris = stable).
	measure 'Couleur alerte' = ```
			VAR _v3 = [Variation 3 mois %]
			VAR _v12 = [Variation 12 mois %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _v3 ), "#56655F",
			        _v3 > 0.05 && _v12 >= 0, "#C9781C", _v3 < -0.05 && _v12 <= 0, "#0F5C4A", ABS ( _v3 ) > 0.05, "#B08A2E", "#56655F" )
			```
		displayFolder: 7. Alertes
		lineageTag: 94b0a706-6259-5c22-94d4-1175caabfd98

	/// Moyenne des 6 derniers mois disponibles / moyenne des 6 mois avant la dernière campagne − 1 : variation déjà acquise pour la prochaine campagne.
	measure 'Variation anticipée %' = ```
			VAR _last = CALCULATE ( MAX ( fact_indice[date] ), ALL ( fact_indice ) )
			VAR _compo = SELECTEDVALUE ( dim_matiere[utilisee_composition] ) = TRUE ()
			VAR _cBase = MAXX ( ALL ( param_campagne[campagne] ), param_campagne[campagne] )
			VAR _fin0 = DATE ( _cBase, 1, 1 )
			VAR _moy1 = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ),
			    dim_date[date] > EDATE ( _last, -6 ), dim_date[date] <= _last )
			VAR _moy0 = CALCULATE ( AVERAGE ( fact_indice[valeur_eur] ), REMOVEFILTERS ( dim_date ),
			    dim_date[date] >= EDATE ( _fin0, -6 ), dim_date[date] < _fin0 )
			VAR _r = DIVIDE ( _moy1, _moy0 )
			RETURN
			    IF ( HASONEVALUE ( dim_matiere[matiere_id] ) && _compo && NOT ISBLANK ( _r ), _r - 1 )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Alertes
		lineageTag: cede5820-fd9e-520a-b229-069f35093b86

	/// Hausse que les matières justifient déjà pour la prochaine campagne, sur le tarif en vigueur pondéré par les volumes : au-delà, la demande est contestable.
	measure 'Plafond justifié prochaine campagne %' = ```
			VAR _c = [Prochaine campagne]
			VAR _w = [Fenêtre mois]
			VAR _lag = [Décalage mois]
			VAR _t =
			    CALCULATETABLE (
			        fact_hausse_article,
			        fact_hausse_article[campagne] = _c,
			        fact_hausse_article[fenetre] = _w,
			        fact_hausse_article[decalage] = _lag,
			        fact_hausse_article[comparable] = TRUE ()
			    )
			RETURN
			    DIVIDE ( SUMX ( _t, fact_hausse_article[hausse_justifiee] * fact_hausse_article[prix_n] * fact_hausse_article[volume_n] ), SUMX ( _t, fact_hausse_article[prix_n] * fact_hausse_article[volume_n] ) )
			```
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 7. Alertes
		lineageTag: f002e442-3d2a-5f49-b9ca-f4687f0bf0c3

	/// Surcoût que les matières justifient déjà pour la prochaine campagne (Σ part × variation acquise × prix × volume). Si une matière est sélectionnée, seule sa contribution est comptée : articles impactés par cette matière.
	measure 'Impact € prochaine campagne' = ```
			VAR _w = [Fenêtre mois]
			VAR _lag = [Décalage mois]
			VAR _r =
			    CALCULATE (
			        SUM ( fact_impact_matiere[impact] ),
			        fact_impact_matiere[fenetre] = _w,
			        fact_impact_matiere[decalage] = _lag
			    )
			RETURN
			    IF ( _r <> 0, _r )
			```
		formatString: #,0 €
		displayFolder: 7. Alertes
		lineageTag: e8d0abf7-7b16-509d-841e-dee564afde07

	/// Quantité achetée sur la dernière année complète.
	measure 'Volume annuel' = ```
			VAR _cBase = MAXX ( ALL ( param_campagne[campagne] ), param_campagne[campagne] )
			RETURN
			    CALCULATE ( SUM ( fact_achats[quantite] ), REMOVEFILTERS ( dim_date ), dim_date[annee] = _cBase - 1 )
			```
		formatString: #,0
		displayFolder: 7. Alertes
		lineageTag: 564885b6-6f55-59dd-9e3e-028c55b1b998

	/// Action selon le plafond de la prochaine campagne et l'écart du fournisseur sur la dernière : baisse → convoquer ; écart > 3 pts → exiger le détail matière ; > 1 pt → plafonner au justifié ; sinon accepter jusqu'au plafond.
	measure 'Action fournisseur' = ```
			VAR _p = [Plafond justifié prochaine campagne %]
			VAR _c = MAXX ( ALL ( param_campagne[campagne] ), param_campagne[campagne] )
			VAR _e = CALCULATE ( [Écart pts], param_campagne[campagne] = _c )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (),
			        _p < 0, "▼ Convoquer : baisse à obtenir",
			        _e > 3, "▲ Exiger le détail matière",
			        _e > 1, "◆ Plafonner à " & FORMAT ( _p, "+0.0 %" ),
			        "● Accepter jusqu'à " & FORMAT ( _p, "+0.0 %" ) )
			```
		displayFolder: 7. Alertes
		lineageTag: 2af1133a-157a-53d9-9be0-d8be6ad9cf46

	/// Vert = baisse à obtenir, ambre = fournisseur en écart, ambre clair = à surveiller, gris = accepter.
	measure 'Couleur action' = ```
			VAR _p = [Plafond justifié prochaine campagne %]
			VAR _c = MAXX ( ALL ( param_campagne[campagne] ), param_campagne[campagne] )
			VAR _e = CALCULATE ( [Écart pts], param_campagne[campagne] = _c )
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), "#56655F", _p < 0, "#0F5C4A", _e > 3, "#C9781C", _e > 1, "#B08A2E", "#56655F" )
			```
		displayFolder: 7. Alertes
		lineageTag: 0d4af545-fdcd-54c9-aa59-fe646b8f2dd9

	/// Décalage d'application qui explique le mieux la hausse demandée (écart minimal entre demandé et justifié) : mesure le retard de répercussion du fournisseur.
	measure 'Décalage estimé (mois)' = ```
			VAR _t = ADDCOLUMNS ( ALL ( param_decalage[decalage_mois] ), "@e", ABS ( [Écart pts] ) )
			VAR _best = TOPN ( 1, FILTER ( _t, NOT ISBLANK ( [@e] ) ), [@e], ASC, param_decalage[decalage_mois], ASC )
			RETURN
			    MAXX ( _best, param_decalage[decalage_mois] )
			```
		formatString: 0 "mois"
		displayFolder: 8. Décalage
		lineageTag: 41b03e17-2c0f-5809-94dc-c8a20bb4f370

	/// Décalage moyen de répercussion sur les campagnes où les matières montent.
	measure 'Délai hausses (mois)' = ```
			AVERAGEX (
			    FILTER ( ALL ( param_campagne[campagne] ), [Hausse justifiée %] > 0 ),
			    [Décalage estimé (mois)]
			)
			```
