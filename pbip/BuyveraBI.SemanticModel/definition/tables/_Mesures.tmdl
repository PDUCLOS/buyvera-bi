	/// Fourchette à 80 % de la variation 2027 attendue.
	measure 'Fourchette 2027' = ```
			VAR _b = AVERAGE ( ml_variation_2027[variation_basse] )
			VAR _h = AVERAGE ( ml_variation_2027[variation_haute] )
			RETURN
