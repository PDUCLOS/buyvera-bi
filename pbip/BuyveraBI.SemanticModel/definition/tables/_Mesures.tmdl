	/// Hausse justifiable 2027 projetée, pondérée par prix 2026 × volume 2025.
	measure 'Plafond 2027 projeté %' = DIVIDE ( SUMX ( ml_plafond_2027, ml_plafond_2027[poids] * ml_plafond_2027[plafond_central] ), SUM ( ml_plafond_2027[poids] ) )
