		lineageTag: 0996f5ef-4ed6-514f-b970-f0051241d690

	/// Segment de comportement tarifaire du fournisseur (KMeans).
	measure 'Segment ML' = SELECTEDVALUE ( ml_segments_fournisseurs[segment_nom] )
		displayFolder: 10. Prévisions ML
		lineageTag: 680d39da-ebd6-51c4-aa52-348c86ffec02

	/// Écart moyen demandé − justifié sur 3 campagnes.
	measure 'Écart moyen 3 campagnes (pts)' = AVERAGE ( ml_segments_fournisseurs[ecart_moyen] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 10. Prévisions ML
		lineageTag: 9dd94ac2-ebf5-58f0-84d4-2cfaccd4824d

	/// Lignes du tarif 2026 isolées en écart non justifié (hausse excessive ou baisse non répercutée).
	measure 'Lignes anormales' = CALCULATE ( COUNTROWS ( ml_anomalies_tarif ), ml_anomalies_tarif[anomalie] = TRUE (), ml_anomalies_tarif[ecart] > 0 )
		formatString: #,0
		displayFolder: 10. Prévisions ML
		lineageTag: fcdcbef0-af7a-5b4f-8409-b78539562e66

	/// Écart en euros des lignes isolées en hausse excessive.
	measure '€ lignes anormales' = CALCULATE ( SUM ( ml_anomalies_tarif[enjeu_eur] ), ml_anomalies_tarif[anomalie] = TRUE (), ml_anomalies_tarif[ecart] > 0 )
		formatString: #,0 €
		displayFolder: 10. Prévisions ML
		lineageTag: bc402086-1e66-5f77-8c02-ed401120ee24

	/// Hausse demandée de la ligne.
	measure 'Demandée (ligne) %' = AVERAGE ( ml_anomalies_tarif[demandee] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10. Prévisions ML
		lineageTag: 2e1405d1-6e38-5e5a-8d5e-f95dd4449e82

	/// Hausse justifiée de la ligne.
	measure 'Justifiée (ligne) %' = AVERAGE ( ml_anomalies_tarif[hausse_justifiee] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10. Prévisions ML
		lineageTag: e4e541f1-f901-5893-8280-6ad4da026b36

	/// Quantités × prix payé dans l'ERP des sites.
	measure 'Montant payé' = SUMX ( fact_achats_entite, fact_achats_entite[quantite] * fact_achats_entite[prix_paye] )
		formatString: #,0 €
		displayFolder: 11. Groupe
		lineageTag: 80e4e907-8354-5aa6-9247-fa10bbcc08cb

	/// Ce que les sites paient au-dessus du meilleur prix obtenu par un site du groupe pour le même article la même année.
	measure 'Surcoût vs meilleur prix groupe' = SUM ( fact_achats_entite[surcout_vs_meilleur] )
		formatString: #,0 €
		displayFolder: 11. Groupe
		lineageTag: 92cab244-4a89-5353-8001-22f546f2783b

	/// Surcoût vs meilleur prix groupe / montant payé par les sites sur la période filtrée (64 M€ sur 2023-2026).
	measure '% surcoût groupe' = DIVIDE ( [Surcoût vs meilleur prix groupe], [Montant payé] )
		formatString: 0.0%
		displayFolder: 11. Groupe
		lineageTag: 3139ec15-8ea0-5f8e-9d91-b26ae4244c54

	/// Montant payé / quantité.
	measure 'Prix payé moyen' = DIVIDE ( [Montant payé], SUM ( fact_achats_entite[quantite] ) )
		formatString: #,0.00 €
		displayFolder: 11. Groupe
		lineageTag: ed58ffe7-00fb-508b-8a30-c92cb50e99db

	/// Meilleur prix moyen payé par un site du groupe pour l'article et l'année, pondéré par les quantités achetées.
	measure 'Meilleur prix groupe' = DIVIDE ( SUMX ( fact_achats_entite, fact_achats_entite[quantite] * fact_achats_entite[meilleur_prix_groupe] ), SUM ( fact_achats_entite[quantite] ) )
		formatString: #,0.00 €
		displayFolder: 11. Groupe
		lineageTag: d4dd5840-87cc-53a3-b971-63be722f859c

	/// Prix payé − prix du tarif, sur les lignes où l'ERP n'applique pas le tarif : positif = payé trop cher.
	measure 'Écart d''application €' = SUM ( fact_achats_entite[ecart_application] )
		formatString: +#,0 €;-#,0 €;0 €
		displayFolder: 11. Groupe
		lineageTag: e4ee5bc0-858d-5a1a-adc1-ca38e542dd25

	/// Ambre si l'écart net est défavorable (payé au-dessus du tarif), vert sinon.
	measure 'Couleur écart application' = IF ( [Écart d'application €] > 0, "#C9781C", "#0F5C4A" )
		displayFolder: 11. Groupe
		lineageTag: 417db863-145f-5c3b-a783-2c372c2db97c

	/// Brut : somme des seules lignes défavorables (payé au-dessus du tarif), sans compenser les lignes favorables.
	measure 'Payé en trop (application)' = SUMX ( FILTER ( fact_achats_entite, fact_achats_entite[ecart_application] > 0 ), fact_achats_entite[ecart_application] )
		formatString: #,0 €
		displayFolder: 11. Groupe
		lineageTag: 7749f413-3cbd-5050-ac46-7c643bad4132

	/// Articles avec au moins une ligne en retard ou en écart durable.
	measure 'Articles en écart d''application' = ```
			CALCULATE ( DISTINCTCOUNT ( fact_achats_entite[article_id] ),
			    fact_achats_entite[statut_prix] IN { "Retard d'application", "Écart durable" } )
			```
		formatString: #,0
		displayFolder: 11. Groupe
		lineageTag: c0b2204c-5a77-57da-887f-12ee5d1df114

	/// Hausse refusée au fournisseur × valeur N : ce que la négociation a réellement rapporté.
	measure 'Économies obtenues €' = SUM ( fact_negociation[economie_eur] )
		formatString: #,0 €
		displayFolder: 12. Gains
		lineageTag: 9ed92e78-6823-53cf-ae27-61bf08885fed

	/// € renégociables des campagnes (écart à la hausse justifiée).
	measure 'Potentiel renégociable €' = SUM ( fact_negociation[eur_renegociables] )
		formatString: #,0 €
		displayFolder: 12. Gains
		lineageTag: 0691fd82-1aa0-51f9-9862-eaec325fc4a0

	/// Économies obtenues / potentiel renégociable.
	measure 'Taux de transformation' = DIVIDE ( [Économies obtenues €], [Potentiel renégociable €] )
		formatString: 0%
		displayFolder: 12. Gains
		lineageTag: 33065d53-89c6-5234-afa5-90430f7af15f

	/// Hausse demandée, pondérée par la valeur N.
	measure 'Hausse demandée (négo) %' = DIVIDE ( SUMX ( fact_negociation, fact_negociation[valeur_n] * fact_negociation[hausse_demandee] ), SUM ( fact_negociation[valeur_n] ) )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 12. Gains
		lineageTag: e0af0dac-c9f0-58c6-a1af-0fd50a131046

	/// Hausse finalement accordée, pondérée par la valeur N.
	measure 'Hausse obtenue %' = DIVIDE ( SUMX ( fact_negociation, fact_negociation[valeur_n] * fact_negociation[hausse_obtenue] ), SUM ( fact_negociation[valeur_n] ) )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 12. Gains
		lineageTag: a5056ebe-62be-5427-8428-5d61253b3e73

	/// Hausse justifiée par les matières, pondérée par la valeur N.
	measure 'Hausse justifiée (négo) %' = DIVIDE ( SUMX ( fact_negociation, fact_negociation[valeur_n] * fact_negociation[hausse_justifiee] ), SUM ( fact_negociation[valeur_n] ) )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 12. Gains
		lineageTag: 6a0b78ba-c045-5fa6-adb8-715f852cae42

	/// Conseil d'approvisionnement avant la prochaine campagne, selon le plafond justifié : < 0 → attendre le nouveau tarif ; > 12 % → anticiper les achats avant le 1er janvier ; 6 à 12 % → anticiper sur les références clés ; sinon normal.
	measure 'Conseil appro' = ```
			VAR _p = [Plafond justifié prochaine campagne %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), BLANK (),
			        _p < 0, "▼ Attendre la baisse",
			        _p > 0.12, "▲ Anticiper",
			        _p > 0.06, "◆ Anticiper les réf. clés",
			        "● Normal" )
			```
		displayFolder: 7. Alertes
		lineageTag: 9b49e1d0-595e-53a5-8a33-f18f3aa6e6fb

	/// Vert = attendre la baisse, ambre = anticiper, ambre clair = références clés, gris = normal.
	measure 'Couleur conseil' = ```
			VAR _p = [Plafond justifié prochaine campagne %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( _p ), "#56655F", _p < 0, "#0F5C4A", _p > 0.12, "#C9781C", _p > 0.06, "#B08A2E", "#56655F" )
			```
		displayFolder: 7. Alertes
		lineageTag: 5a6e3302-8043-51ec-bdb7-03864b704d79

	column masque
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 814b89bf-f60b-5761-b21f-6342f670c157
		summarizeBy: none
		isNameInferred
		sourceColumn: [masque]

		annotation SummarizationSetBy = User

	partition _Mesures = calculated
		mode: import
		source = ROW ( "masque", 0 )
